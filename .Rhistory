install.packages("CircStats")
library("CircStats")
library(pracma)
hours <- c(12,12,12,12,12,12,12,12,12,16,16,16,15,15,16,14,14,11,11,10,11,13,13,13,23,5,6,7,1,2,5,9)
hours2 <- c(2,2,2,2,2,2,2,2,6,6,6,6,6,6,8,7,9,5,3,11,13,23,21,20,15,17,4,5,2,2,5,6,8,11,3,4,5,7,9,1)
circ.plotcir <- function(x, main = "", pch = 16, stack = FALSE, bins = 0, cex = 1, dotsep = 40, shrink = 1.2) {
x <- x %% (2 * pi)
eqscplot(x=cos(seq(0, 2 * pi, length = 1000)), y=sin(seq(0, 2 * pi, length = 1000)), axes = FALSE, xlab = "", ylab = "", main = main, type = "l", xlim = shrink * c(-1, 1), ylim = shrink * c(-1, 1), ratio=1, tol=0.04)
lines(c(0, 0), c(0.9, 1))
text(0.005, 0.85, "6", cex = 1.5)
lines(c(0, 0), c(-0.9, -1))
text(0.005, -0.825, "18", cex = 1.5)
lines(c(-1, -0.9), c(0, 0))
text(-0.8, 0, "12", cex = 1.5)
lines(c(0.9, 1), c(0, 0))
text(0.82, 0, "24", cex = 1.5)
text(0, 0, "+", cex = 2)
n <- length(x)
z <- cos(x)
y <- sin(x)
if(stack == FALSE) {
points(z, y, cex = cex, pch = pch)
} else {
bins.count <- c(1:bins)
arc <- (2 * pi)/bins
for(i in 1:bins) {
bins.count[i] <- sum(x <= i * arc & x > (i - 1) * arc)
}
mids <- seq(arc/2, 2 * pi - pi/bins, length = bins)
index <- cex/dotsep
for(i in 1:bins) {
if(bins.count[i] != 0) {
for(j in 0:(bins.count[i] - 1)) {
r <- runif(1, 0.5, 1)
#r <- 1 + j * index
z <- r * cos(mids[i])
y <- r * sin(mids[i])
points(z, y, cex = cex, pch = pch, col="chartreuse4")
}
}
}
}
mean.dir <- circ.mean(x)
rs <-r.test(x, degree=FALSE)
dir <- as.numeric(rs[1])
z <- dir*cos(mean.dir)
y <- dir*sin(mean.dir)
par(new=TRUE)
eqscplot(x=0.2*cos(seq(0, 2 * pi, length = 1000)), y=0.2*sin(seq(0, 2 * pi, length = 1000)), main = main, col="blue", type = "l", axes = FALSE, xlab = "", ylab = "",xlim = shrink * c(-1, 1), ylim = shrink * c(-1, 1), ratio=1, tol=0.04)
lines(c(z,0),c(y,0),col = "red",lwd=3)
}
circ.plotcir((2*pi*(hours2))/24, main="",stack=TRUE, bins=150, shrink=1.5)
x = (2*pi*(hours))/24
circ.plotcir((2*pi*(hours2))/24, main="",stack=TRUE, bins=150, shrink=1.5)
x = (2*pi*(hours))/24 #si esta en DD el 24 deberia ir el tau (periodo propio de cada sujeto/individuo)
y = (2*pi*(hours2))/24
circ.summary(x)
circ.summary(y)
rao.spacing(x, alpha=0, rad=TRUE)
rao.spacing(y, alpha=0, rad=TRUE)
r.test(x, degree=FALSE)
r.test(y, degree=FALSE)
watson.two(x, y, alpha=0.05, plot=TRUE)
watson.two(x, y)
circ.plotcir2 <- function(x,y1, main = "", pch = 16, stack = FALSE, bins = 0, cex = 1, dotsep = 40, shrink = 1.2) {
x <- x %% (2 * pi)
eqscplot(x=cos(seq(0, 2 * pi, length = 1000)), y=sin(seq(0, 2 * pi, length = 1000)), axes = FALSE, xlab = "", ylab = "", main = main, type = "l", xlim = shrink * c(-1, 1), ylim = shrink * c(-1, 1), ratio=1, tol=0.04)
lines(c(0, 0), c(0.9, 1))
text(0.005, 0.85, "24", cex = 1.5)
lines(c(0, 0), c(-0.9, -1))
text(0.005, -0.825, "12", cex = 1.5)
lines(c(-1, -0.9), c(0, 0))
text(-0.8, 0, "18", cex = 1.5)
lines(c(0.9, 1), c(0, 0))
text(0.82, 0, "6", cex = 1.5)
text(0, 0, "+", cex = 2)
n <- length(x)
z <- cos(x)
y <- sin(x)
if(stack == FALSE) {
points(z, y, cex = cex, pch = pch)
} else {
bins.count <- c(1:bins)
arc <- (2 * pi)/bins
for(i in 1:bins) {
bins.count[i] <- sum(x <= i * arc & x > (i - 1) * arc)
}
mids <- seq(arc/2, 2 * pi - pi/bins, length = bins)
index <- cex/dotsep
for(i in 1:bins) {
if(bins.count[i] != 0) {
for(j in 0:(bins.count[i] - 1)) {
r <- runif(1, 0.5, 1)
#r <- 1 + j * index
z <- r * cos(mids[i])
y <- r * sin(mids[i])
points(z, y, cex = cex, pch = pch, col="chartreuse4")
}
}
}
}
#########################################
mean.dir <- circ.mean(x)
rs <-r.test(x, degree=FALSE)
dir <- as.numeric(rs[1])
z <- dir*cos(mean.dir)
y <- dir*sin(mean.dir)
par(new=TRUE)
lines(c(z,0),c(y,0),col = "chartreuse4",lwd=3)
################################################
y1 <- y1 %% (2 * pi)
n <- length(y1)
z <- cos(y1)
y <- sin(y1)
if(stack == FALSE) {
points(z, y, cex = cex, pch = pch)
} else {
bins.count <- c(1:bins)
arc <- (2 * pi)/bins
for(i in 1:bins) {
bins.count[i] <- sum(y1 <= i * arc & y1 > (i - 1) * arc)
}
mids <- seq(arc/2, 2 * pi - pi/bins, length = bins)
index <- cex/dotsep
for(i in 1:bins) {
if(bins.count[i] != 0) {
for(j in 0:(bins.count[i] - 1)) {
r <- runif(1, 0.5, 1)
#r <- 1 + j * index
z <- r * cos(mids[i])
y <- r * sin(mids[i])
points(z, y, cex = cex, pch = pch, col="red")
}
}
}
}
#######################################################
mean.dir <- circ.mean(y1)
rs <-r.test(y1, degree=FALSE)
dir <- as.numeric(rs[1])
z <- dir*cos(mean.dir)
y <- dir*sin(mean.dir)
par(new=TRUE)
lines(c(z,0),c(y,0),col = "red",lwd=3)
######################################################
par(new=TRUE)
eqscplot(x=0.2*cos(seq(0, 2 * pi, length = 1000)), y=0.2*sin(seq(0, 2 * pi, length = 1000)), main = main, col="blue", type = "l", axes = FALSE, xlab = "", ylab = "",xlim = shrink * c(-1, 1), ylim = shrink * c(-1, 1), ratio=1, tol=0.04)
}
circ.plotcir2(x,y, main="",stack=TRUE, bins=150, shrink=1.5)
